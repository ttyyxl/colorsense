NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Production example:
# NEXT_PUBLIC_APP_URL=https://steel-two-60.vercel.app
# NEXT_PUBLIC_API_BASE_URL=https://your-api.example.com

# Firebase Admin (Server Side)
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_CLIENT_EMAIL=your_service_account_email_here
FIREBASE_PRIVATE_KEY=your_private_key_here

# WeatherAPI.com (Server Side)
WEATHERAPI_KEY=your_weatherapi_key_here

# Doubao outfit advice (Server Side only) - used by src/lib/ai.ts
# Keep this separate from the vision diagnosis key below.
DOUBAO_API_KEY=your_doubao_api_key_here

# Volcengine Ark - Doubao vision diagnosis (Server Side only)
# NEVER prefix these with NEXT_PUBLIC_ ; never commit real values.
# Master switch: when false, the vision module and test script make NO paid API calls.
VISION_DIAGNOSIS_ENABLED=false
# OpenAI-compatible endpoint provided by Volcengine Ark.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Vision-diagnosis API key (do not reuse the outfit-advice key).
ARK_API_KEY=your_ark_api_key_here
# Doubao-Seed-2.0-Lite model / endpoint ID from your Ark console.
ARK_VISION_MODEL=your_doubao_seed_2_0_lite_model_id_here

# CNN + Doubao 40:60 融合（Server Side only）
# 两个开关必须同时为 true 才会调用付费视觉模型；默认均保持关闭。
FUSION_ENABLED=false
# CNN 权重，默认 0.4；Doubao 权重自动取 1 - 该值。启用融合后必须是 [0,1] 内的有限数字。
FUSION_CNN_WEIGHT=0.4

# 脱敏诊断日志（Server Side only，默认关闭）
# 开启后仅输出白名单内的机器可读元数据（图片尺寸/字节数/Orientation、模型与耗时、
# finishReason/requestId/token usage、可靠性布尔标志、融合 source/fallbackReason）。
# 不会记录 API Key、Base64、Prompt、人脸照片、自然语言 reason 或用户画像；不写数据库。
VISION_DIAGNOSTICS_LOG_ENABLED=false
