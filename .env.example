NEXT_PUBLIC_APP_URL=http://localhost:3000

# 推理后端（CloudBase 云托管 / 本地 FastAPI 服务）
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
INFERENCE_SERVICE_URL=http://localhost:8000

# CloudBase 环境（腾讯云）
NEXT_PUBLIC_CLOUDBASE_ENV_ID=your_cloudbase_env_id
NEXT_PUBLIC_CLOUDBASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_CLOUDBASE_REGION=ap-shanghai

# 服务端管理员密钥（仅服务端使用，切勿暴露到前端或提交到仓库）
CLOUDBASE_APIKEY=your_service_role_api_key

# WeatherAPI.com (Server Side)
WEATHERAPI_KEY=your_weatherapi_key_here

# 豆包穿搭 / 风格建议（仅服务端，与视觉诊断、生图密钥相互独立）
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=your_doubao_model_id

# 豆包视觉诊断（仅服务端，切勿使用 NEXT_PUBLIC_ 前缀或提交真实密钥）
VISION_DIAGNOSIS_ENABLED=false
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your_ark_vision_api_key
ARK_VISION_MODEL=your_doubao_vision_model_id

# CNN + 豆包视觉 40:60 融合；两个开关同时为 true 才会调用付费视觉模型
FUSION_ENABLED=false
FUSION_CNN_WEIGHT=0.4

# 脱敏诊断日志（默认关闭，不记录密钥、图片、Prompt 或用户画像）
VISION_DIAGNOSTICS_LOG_ENABLED=false

# 豆包 Seedream 形象图卡（仅服务端，使用独立生图密钥）
DOUBAO_IMAGE_ENABLED=false
DOUBAO_IMAGE_API_KEY=your_doubao_image_api_key
DOUBAO_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
DOUBAO_IMAGE_SIZE=2816x1584
DOUBAO_IMAGE_TIMEOUT_MS=90000

# Production example:
# NEXT_PUBLIC_APP_URL=https://your-domain.example.com
# NEXT_PUBLIC_API_BASE_URL=https://your-inference-service.example.com
