NEXT_PUBLIC_APP_URL=http://localhost:3000

# 推理后端（CloudBase 云托管 / 本地 FastAPI 服务）
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
INFERENCE_SERVICE_URL=http://localhost:8000

# CloudBase 环境（腾讯云）
NEXT_PUBLIC_CLOUDBASE_ENV_ID=your_cloudbase_env_id
NEXT_PUBLIC_CLOUDBASE_PUBLISHABLE_KEY=your_publishable_key
NEXT_PUBLIC_CLOUDBASE_REGION=ap-shanghai

# 服务端管理员密钥（仅服务端使用，切勿暴露到前端或提交到仓库）
CLOUDBASE_APIKEY=your_service_role_api_key

# WeatherAPI.com (Server Side)
WEATHERAPI_KEY=your_weatherapi_key_here

# 豆包大模型（穿搭 / 风格建议）
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=your_doubao_model_id

# Production example:
# NEXT_PUBLIC_APP_URL=https://your-domain.example.com
# NEXT_PUBLIC_API_BASE_URL=https://your-inference-service.example.com
